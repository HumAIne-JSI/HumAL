# ============================================================================
# HumAL Frontend Environment
# ============================================================================
# Copy this file to `.env` (or `.env.local`) and adjust as needed.
# All variables MUST be prefixed with `VITE_` to be exposed to the app.

# Base URL of the HumAL backend API (no trailing slash, no /docs suffix).
# Live/deployed backend:
VITE_API_BASE_URL=https://al-api.humaine-horizon.eu

# Local backend (uncomment to develop against a locally running API):
# VITE_API_BASE_URL=http://localhost:8000

# Base URL of the external Resolution Task API (al-fr-api). The Resolution tab
# calls this SEPARATE server directly from the browser (no trailing slash).
VITE_RESOLUTION_API_BASE_URL=https://al-fr-api.humaine-horizon.eu

# Force the app to talk to the real API even in `npm run dev`.
# Leave unset to allow the in-app mock toggle to default to mock data in dev.
VITE_USE_REAL_API=true
