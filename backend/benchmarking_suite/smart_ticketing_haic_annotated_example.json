

{
  // [ADDED] Top-level artifact envelope required by the platform.
  "artifact_schema": "haic.decisions_artifact.v1",
  "schema_version": "haic.decisions.v1",

  // [ADDED] A stable identifier for this labeling session.
  "session_id": "st_session_20260520T150411",

  // [ADDED] Session-level metadata block.
  // Required for EL baseline derivation and cross-pilot comparison.
  "meta": {
    "pilot_tag": "smart_ticketing",
    "application": {
      "name": "Smart Ticketing AL Platform",
      "version": "1.0.0"
    },
    "ai_system": {
      "model_name": "random forest",
      "model_type": "classifier"
    },
    "task": {
      "name": "active_learning_ticket_triage",
      "domain": "customer_support",
      "unit_of_work": "ticket"
    },
    "human": {
